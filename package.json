{
  "name": "daily-checkin",
  "version": "2.1.0",
  "private": true,
  "description": "带连续打卡、修复券、热力图、成就、云同步与打卡搭子的每日习惯应用(桌面 + Web)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "serve": "node server.js",
    "test": "node --test test/core.test.js test/merge.test.js && node test/server.e2e.mjs",
    "build": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "habit-tracker",
    "daily-checkin",
    "sqlite",
    "pwa",
    "productivity"
  ],
  "author": "Daily Check-in contributors",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.daily.checkin",
    "productName": "每日打卡",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "storage.js",
      "renderer.js",
      "sync.js",
      "daily-checkin.html",
      "daily-checkin.json",
      "manifest.webmanifest",
      "icon.svg",
      "sw.js",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
