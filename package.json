{
  "name": "daily-checkin",
  "version": "1.1.0",
  "private": true,
  "description": "每日打卡桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.daily.checkin",
    "productName": "每日打卡",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "daily-checkin.html",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
